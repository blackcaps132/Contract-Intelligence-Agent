# ==============================================================================
# CONTRACT INTELLIGENCE & VERSIONING AGENT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- LLM API Keys ---
# Provide at least one API key below for generative reasoning and analysis.
# For Google Gemini (Recommended): Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# For OpenAI (Optional alternative): Get your key at https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# --- Model Selection ---
DEFAULT_MODEL=gemini-2.5-flash
DEFAULT_TEMPERATURE=0.1

# --- Vector Database & Embeddings ---
EMBEDDING_MODEL=models/text-embedding-004
CHROMA_PERSIST_DIR=./backend/data/chroma_db

# --- Database & Storage ---
SQLITE_DB_PATH=./backend/data/contracts.db

# --- Application Server ---
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
